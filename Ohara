    &lt;script&gt;
        // Game Engine
        class BubbleShooterGame {
            constructor() {
                this.canvas = null;
                this.ctx = null;
                this.gameWidth = 600;
                this.gameHeight = 400;
                this.bubbles = [];
                this.currentBubble = null;
                this.bubbleRadius = 20;
                this.colors = ['#ff6b6b', '#4ecdc4', '#45b7d1', '#96ceb4', '#ffeaa7', '#dda0dd', '#98d8c8'];
                this.score = 0;
                this.gameRunning = false;
                this.aimAngle = 0;
                this.cannonX = 300;
                this.cannonY = 350;
                this.bubbleSpeed = 8;
                this.init();
            }

            init() {
                this.createCanvas();
                this.createBubbleGrid();
                this.createCurrentBubble();
                this.bindEvents();
                this.gameLoop();
            }

            createCanvas() {
                const gameContainer = document.getElementById('gameContainer');
                gameContainer.innerHTML = `
                    &lt;div class="game-canvas" style="position: relative;"&gt;
                        &lt;canvas id="gameCanvas" width="600" height="400" style="width: 100%; height: 100%; max-width: 600px;"&gt;&lt;/canvas&gt;
                        &lt;div class="cannon"&gt;ğŸ¯&lt;/div&gt;
                        &lt;div class="aim-line" id="aimLine" style="display: none;"&gt;&lt;/div&gt;
                    &lt;/div&gt;
                `;
                
                this.canvas = document.getElementById('gameCanvas');
                this.ctx = this.canvas.getContext('2d');
                this.gameRunning = true;
            }

            createBubbleGrid() {
                this.bubbles = [];
                const rows = 6;
                const cols = 12;
                
                for (let row = 0; row &lt; rows; row++) {
                    for (let col = 0; col &lt; cols; col++) {
                        if (Math.random() &gt; 0.3) {
                            const x = col * (this.bubbleRadius * 2) + (row % 2) * this.bubbleRadius + this.bubbleRadius;
                            const y = row * (this.bubbleRadius * 1.8) + this.bubbleRadius;
                            
                            if (x &lt; this.gameWidth - this.bubbleRadius) {
                                this.bubbles.push({
                                    x: x,
                                    y: y,
                                    color: this.colors[Math.floor(Math.random() * this.colors.length)],
                                    radius: this.bubbleRadius
                                });
                            }
                        }
                    }
                }
            }

            createCurrentBubble() {
                this.currentBubble = {
                    x: this.cannonX,
                    y: this.cannonY,
                    vx: 0,
                    vy: 0,
                    color: this.colors[Math.floor(Math.random() * this.colors.length)],
                    radius: this.bubbleRadius,
                    moving: false
                };
            }

            bindEvents() {
                this.canvas.addEventListener('mousemove', (e) =&gt; {
                    if (!this.gameRunning || this.currentBubble.moving) return;
                    
                    const rect = this.canvas.getBoundingClientRect();
                    const scaleX = this.canvas.width / rect.width;
                    const scaleY = this.canvas.height / rect.height;
                    
                    const mouseX = (e.clientX - rect.left) * scaleX;
                    const mouseY = (e.clientY - rect.top) * scaleY;
                    
                    this.aimAngle = Math.atan2(mouseY - this.cannonY, mouseX - this.cannonX);
                    this.updateAimLine();
                });

                this.canvas.addEventListener('click', () =&gt; {
                    this.shoot();
                });

                // Touch events for mobile
                this.canvas.addEventListener('touchstart', (e) =&gt; {
                    e.preventDefault();
                    const touch = e.touches[0];
                    const rect = this.canvas.getBoundingClientRect();
                    const scaleX = this.canvas.width / rect.width;
                    const scaleY = this.canvas.height / rect.height;
                    
                    const touchX = (touch.clientX - rect.left) * scaleX;
                    const touchY = (touch.clientY - rect.top) * scaleY;
                    
                    this.aimAngle = Math.atan2(touchY - this.cannonY, touchX - this.cannonX);
                    this.shoot();
                });
            }

            updateAimLine() {
                const aimLine = document.getElementById('aimLine');
                if (aimLine &amp;&amp; !this.currentBubble.moving) {
                    const length = 100;
                    const endX = this.cannonX + Math.cos(this.aimAngle) * length;
                    const endY = this.cannonY + Math.sin(this.aimAngle) * length;
                    
                    if (endY &lt; this.cannonY) {
                        aimLine.style.display = 'block';
                        aimLine.style.height = length + 'px';
                        aimLine.style.transform = `translateX(-50%) rotate(${this.aimAngle + Math.PI/2}rad)`;
                    } else {
                        aimLine.style.display = 'none';
                    }
                }
            }

            shoot() {
                if (!this.gameRunning || this.currentBubble.moving) return;
                
                // Only allow shooting upward
                if (this.aimAngle &gt; -Math.PI &amp;&amp; this.aimAngle &lt; 0) {
                    this.currentBubble.vx = Math.cos(this.aimAngle) * this.bubbleSpeed;
                    this.currentBubble.vy = Math.sin(this.aimAngle) * this.bubbleSpeed;
                    this.currentBubble.moving = true;
                    
                    document.getElementById('aimLine').style.display = 'none';
                    
                    // Play shoot sound
                    this.playSound('shoot');
                }
            }

            aimLeft() {
                this.aimAngle = Math.max(this.aimAngle - 0.1, -Math.PI + 0.1);
                this.updateAimLine();
            }

            aimRight() {
                this.aimAngle = Math.min(this.aimAngle + 0.1, -0.1);
                this.updateAimLine();
            }

            update() {
                if (!this.gameRunning) return;

                if (this.currentBubble.moving) {
                    // Update bubble position
                    this.currentBubble.x += this.currentBubble.vx;
                    this.currentBubble.y += this.currentBubble.vy;

                    // Wall collision
                    if (this.currentBubble.x &lt;= this.bubbleRadius || this.currentBubble.x &gt;= this.gameWidth - this.bubbleRadius) {
                        this.currentBubble.vx *= -1;
                    }

                    // Check collision with existing bubbles
                    let collisionDetected = false;
                    for (let bubble of this.bubbles) {
                        const dx = this.currentBubble.x - bubble.x;
                        const dy = this.currentBubble.y - bubble.y;
                        const distance = Math.sqrt(dx * dx + dy * dy);

                        if (distance &lt;= this.bubbleRadius * 2) {
                            collisionDetected = true;
                            break;
                        }
                    }

                    // Check if bubble reached top
                    if (this.currentBubble.y &lt;= this.bubbleRadius || collisionDetected) {
                        this.attachBubble();
                    }
                }
            }

            attachBubble() {
                // Find nearest grid position
                let nearestX = Math.round((this.currentBubble.x - this.bubbleRadius) / (this.bubbleRadius * 2)) * (this.bubbleRadius * 2) + this.bubbleRadius;
                let nearestY = Math.round((this.currentBubble.y - this.bubbleRadius) / (this.bubbleRadius * 1.8)) * (this.bubbleRadius * 1.8) + this.bubbleRadius;

                // Add to bubbles array
                this.bubbles.push({
                    x: nearestX,
                    y: nearestY,
                    color: this.currentBubble.color,
                    radius: this.bubbleRadius
                });

                // Check for matches
                this.checkMatches(nearestX, nearestY, this.currentBubble.color);

                // Create new bubble
                this.createCurrentBubble();

                // Check win condition
                if (this.bubbles.length === 0) {
                    this.gameWin();
                }

                // Check lose condition
                const lowestBubble = Math.max(...this.bubbles.map(b =&gt; b.y));
                if (lowestBubble &gt; this.cannonY - 50) {
                    this.gameOver();
                }
            }

            checkMatches(x, y, color) {
                const matches = [];
                const visited = new Set();
                
                const findMatches = (bx, by) =&gt; {
                    const key = `${bx},${by}`;
                    if (visited.has(key)) return;
                    visited.add(key);

                    for (let bubble of this.bubbles) {
                        const dx = bubble.x - bx;
                        const dy = bubble.y - by;
                        const distance = Math.sqrt(dx * dx + dy * dy);

                        if (distance &lt;= this.bubbleRadius * 2.1 &amp;&amp; bubble.color === color) {
                            if (!matches.some(m =&gt; m.x === bubble.x &amp;&amp; m.y === bubble.y)) {
                                matches.push(bubble);
                                findMatches(bubble.x, bubble.y);
                            }
                        }
                    }
                };

                findMatches(x, y);

                if (matches.length &gt;= 3) {
                    // Remove matched bubbles
                    matches.forEach(match =&gt; {
                        const index = this.bubbles.findIndex(b =&gt; b.x === match.x &amp;&amp; b.y === match.y);
                        if (index &gt; -1) {
                            this.bubbles.splice(index, 1);
                        }
                    });

                    // Award points and money
                    const points = matches.length * 10;
                    const money = matches.length &gt;= 5 ? 0.25 : matches.length &gt;= 3 ? 0.10 : 0;
                    
                    this.score += points;
                    if (money &gt; 0) {
                        earnMoney(money, `Popped ${matches.length} bubbles!`);
                    }

                    // Play pop sound
                    this.playSound('pop');

                    // Check for floating bubbles
                    this.removeFloatingBubbles();
                }
            }

            removeFloatingBubbles() {
                const connected = new Set();
                
                // Find all bubbles connected to the top
                const findConnected = (bubble) =&gt; {
                    const key = `${bubble.x},${bubble.y}`;
                    if (connected.has(key)) return;
                    connected.add(key);

                    for (let other of this.bubbles) {
                        if (other !== bubble) {
                            const dx = other.x - bubble.x;
                            const dy = other.y - bubble.y;
                            const distance = Math.sqrt(dx * dx + dy * dy);

                            if (distance &lt;= this.bubbleRadius * 2.1 &amp;&amp; !connected.has(`${other.x},${other.y}`)) {
                                findConnected(other);
                            }
                        }
                    }
                };

                // Start from top row bubbles
                this.bubbles.filter(b =&gt; b.y &lt;= this.bubbleRadius * 2).forEach(findConnected);

                // Remove unconnected bubbles
                const floating = this.bubbles.filter(b =&gt; !connected.has(`${b.x},${b.y}`));
                floating.forEach(bubble =&gt; {
                    const index = this.bubbles.findIndex(b =&gt; b.x === bubble.x &amp;&amp; b.y === bubble.y);
                    if (index &gt; -1) {
                        this.bubbles.splice(index, 1);
                        earnMoney(0.05, 'Floating bubble bonus!');
                    }
                });
            }

            render() {
                // Clear canvas
                this.ctx.clearRect(0, 0, this.gameWidth, this.gameHeight);

                // Draw bubbles
                this.bubbles.forEach(bubble =&gt; {
                    this.drawBubble(bubble.x, bubble.y, bubble.radius, bubble.color);
                });

                // Draw current bubble
                if (this.currentBubble) {
                    this.drawBubble(this.currentBubble.x, this.currentBubble.y, this.currentBubble.radius, this.currentBubble.color);
                }

                // Draw score
                this.ctx.fillStyle = 'white';
                this.ctx.font = '20px Arial';
                this.ctx.fillText(`Score: ${this.score}`, 10, 30);
            }

            drawBubble(x, y, radius, color) {
                this.ctx.beginPath();
                this.ctx.arc(x, y, radius, 0, Math.PI * 2);
                this.ctx.fillStyle = color;
                this.ctx.fill();
                this.ctx.strokeStyle = 'rgba(255,255,255,0.3)';
                this.ctx.lineWidth = 2;
                this.ctx.stroke();
                
                // Add shine effect
                this.ctx.beginPath();
                this.ctx.arc(x - radius/3, y - radius/3, radius/3, 0, Math.PI * 2);
                this.ctx.fillStyle = 'rgba(255,255,255,0.3)';
                this.ctx.fill();
            }

            gameLoop() {
                this.update();
                this.render();
                requestAnimationFrame(() =&gt; this.gameLoop());
            }

            gameWin() {
                this.gameRunning = false;
                earnMoney(1.0, 'Level Complete Bonus!');
                showNotification('ğŸ‰ Level Complete! +â‚¹1.00 bonus!', 'success');
                
                setTimeout(() =&gt; {
                    this.score = 0;
                    this.createBubbleGrid();
                    this.createCurrentBubble();
                    this.gameRunning = true;
                }, 2000);
            }

            gameOver() {
                this.gameRunning = false;
                showNotification('Game Over! Try again!', 'info');
                
                setTimeout(() =&gt; {
                    this.score = 0;
                    this.createBubbleGrid();
                    this.createCurrentBubble();
                    this.gameRunning = true;
                }, 2000);
            }

            playSound(type) {
                // Simple procedural sound generation
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                if (type === 'shoot') {
                    oscillator.frequency.setValueAtTime(400, audioContext.currentTime);
                    oscillator.frequency.exponentialRampToValueAtTime(200, audioContext.currentTime + 0.1);
                } else if (type === 'pop') {
                    oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
                    oscillator.frequency.exponentialRampToValueAtTime(400, audioContext.currentTime + 0.2);
                }
                
                gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
                
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.2);
            }
        }

        // Earning System
        class EarningSystem {
            constructor() {
                this.balance = parseFloat(localStorage.getItem('balance') || '0');
                this.totalEarnings = parseFloat(localStorage.getItem('totalEarnings') || '0');
                this.todayEarnings = parseFloat(localStorage.getItem('todayEarnings') || '0');
                this.streak = parseInt(localStorage.getItem('streak') || '0');
                this.lastLogin = localStorage.getItem('lastLogin') || '';
                this.achievements = JSON.parse(localStorage.getItem('achievements') || '{}');
                
                this.checkDailyReset();
                this.updateUI();
            }

            checkDailyReset() {
                const today = new Date().toDateString();
                const lastLoginDate = new Date(this.lastLogin).toDateString();
                
                if (today !== lastLoginDate) {
                    if (this.lastLogin &amp;&amp; this.isConsecutiveDay(today, lastLoginDate)) {
                        this.streak++;
                    } else if (this.lastLogin) {
                        this.streak = 1;
                    } else {
                        this.streak = 1;
                    }
                    
                    this.todayEarnings = 0;
                    this.lastLogin = today;
                    this.saveData();
                }
            }

            isConsecutiveDay(today, lastLogin) {
                const todayDate = new Date(today);
                const lastLoginDate = new Date(lastLogin);
                const timeDiff = todayDate.getTime() - lastLoginDate.getTime();
                const daysDiff = Math.ceil(timeDiff / (1000 * 3600 * 24));
                return daysDiff === 1;
            }

            earnMoney(amount, reason) {
                this.balance += amount;
                this.totalEarnings += amount;
                this.todayEarnings += amount;
                this.saveData();
                this.updateUI();
                showNotification(`+â‚¹${amount.toFixed(2)} - ${reason}`, 'success');
            }

            saveData() {
                localStorage.setItem('balance', this.balance.toString());
                localStorage.setItem('totalEarnings', this.totalEarnings.toString());
                localStorage.setItem('todayEarnings', this.todayEarnings.toString());
                localStorage.setItem('streak', this.streak.toString());
                localStorage.setItem('lastLogin', this.lastLogin);
                localStorage.setItem('achievements', JSON.stringify(this.achievements));
            }

            updateUI() {
                document.getElementById('balance').textContent = `â‚¹${this.balance.toFixed(2)}`;
                document.getElementById('totalEarnings').textContent = `â‚¹${this.totalEarnings.toFixed(2)}`;
                document.getElementById('todayEarnings').textContent = `â‚¹${this.todayEarnings.toFixed(2)}`;
                document.getElementById('streak').textContent = this.streak.toString();
                document.getElementById('walletBalance').textContent = `â‚¹${this.balance.toFixed(2)}`;
                document.getElementById('loginStreak').textContent = `${this.streak} days`;
                document.getElementById('yourRank').textContent = `â‚¹${this.totalEarnings.toFixed(2)}`;
                
                const nextRewardAmount = this.getNextDailyReward();
                document.getElementById('nextReward').textContent = `â‚¹${nextRewardAmount.toFixed(2)}`;
            }

            getNextDailyReward() {
                const baseReward = 0.25;
                const streakBonus = Math.min(this.streak * 0.05, 0.50);
                return baseReward + streakBonus;
            }

            claimDailyReward() {
                const today = new Date().toDateString();
                const lastClaim = localStorage.getItem('lastDailyClaim') || '';
                
                if (today !== lastClaim) {
                    const reward = this.getNextDailyReward();
                    this.earnMoney(reward, 'Daily Login Bonus!');
                    localStorage.setItem('lastDailyClaim', today);
                    
                    // Streak milestone bonuses
                    if (this.streak === 7) {
                        this.earnMoney(1.0, '7-Day Streak Bonus!');
                    } else if (this.streak === 14) {
                        this.earnMoney(2.0, '14-Day Streak Bonus!');
                    } else if (this.streak === 30) {
                        this.earnMoney(5.0, '30-Day Streak Bonus!');
                    }
                } else {
                    showNotification('Daily reward already claimed today!', 'info');
                }
            }

            withdraw(amount) {
                if (amount &lt; 10) {
                    showNotification('Minimum withdrawal amount is â‚¹10', 'error');
                    return false;
                }
                
                if (amount &gt; this.balance) {
                    showNotification('Insufficient balance!', 'error');
                    return false;
                }
                
                this.balance -= amount;
                this.saveData();
                this.updateUI();
                
                // Simulate UPI transfer
                showNotification(`â‚¹${amount} withdrawn to UPI: 9753623807@ibl`, 'success');
                return true;
            }
        }

        // Global instances
        let gameEngine;
        let earningSystem;

        // Initialize game when page loads
        window.addEventListener('load', () =&gt; {
            earningSystem = new EarningSystem();
            gameEngine = new BubbleShooterGame();
        });

        // Utility functions
        function earnMoney(amount, reason) {
            if (earningSystem) {
                earningSystem.earnMoney(amount, reason);
            }
        }

        function showNotification(message, type = 'info') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification show ${type}`;
            
            setTimeout(() =&gt; {
                notification.classList.remove('show');
            }, 3000);
        }

        function withdrawMoney() {
            const amount = prompt('Enter withdrawal amount (Min: â‚¹10):');
            if (amount &amp;&amp; !isNaN(amount)) {
                const withdrawAmount = parseFloat(amount);
                earningSystem.withdraw(withdrawAmount);
            }
        }

        function showTransactions() {
            alert(`Transaction History:\n\nTotal Earnings: â‚¹${earningSystem.totalEarnings.toFixed(2)}\nToday's Earnings: â‚¹${earningSystem.todayEarnings.toFixed(2)}\nCurrent Balance: â‚¹${earningSystem.balance.toFixed(2)}\nLogin Streak: ${earningSystem.streak} days`);
        }

        function claimDailyReward() {
            earningSystem.claimDailyReward();
        }

        // Auto-claim daily reward on first visit
        setTimeout(() =&gt; {
            if (earningSystem) {
                earningSystem.claimDailyReward();
            }
        }, 2000);
